# --- deploy time (read by contracts/script/Deploy.s.sol) ---

# Deployer key. Becomes the vault owner: the only address that can withdraw.
# Must be 0x-prefixed. Never commit the filled-in .env.
PRIVATE_KEY=

# Address the agent service signs with. It may only call rebalance().
AGENT_ADDRESS=

# --- run time (read by the agent service) ---

MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Throwaway wallet used by the agent to send rebalance transactions.
# This is the key matching AGENT_ADDRESS above.
# Never use a wallet that holds real funds.
AGENT_PRIVATE_KEY=

# Deployed LeashVault address (populated after running the deploy script)
VAULT_ADDRESS=
